<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hanya build debug: mengizinkan HTTP ke localhost agar test dapat memakai MockWebServer. -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Hanya debug: dipicu lewat adb untuk menguji keadaan premium (lihat BillingModeReceiver). -->
        <receiver
            android:name="com.rds.questlog.debug.BillingModeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rds.questlog.debug.SET_BILLING_MODE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
